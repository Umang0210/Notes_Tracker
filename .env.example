# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Set MONGODB_URI to mongodb://mongodb:27017/notes-tracker if running with docker-compose
MONGODB_URI=mongodb://127.0.0.1:27017/notes-tracker

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (For CORS validation)
FRONTEND_URL=http://localhost:5173

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload Configuration
MAX_FILE_SIZE=5242880
